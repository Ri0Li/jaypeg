# run
INPUT_PATH=/mnt/photos
# scan | dry-run | extract | develop
MODE=scan
LOG_LEVEL=log
INTENT=balanced

# mount
HOST_PATH=/path/to/photos
NAS_ADDR=192.0.2.10
NAS_EXPORT=/volume1/share/photos

# behaviour
DEVELOP_FALLBACK=true

# cron
CRON_ENABLE=false
CRON_START="0 2 * * *"
CRON_STOP="0 6 * * *"

# advanced
REWRITE=false
FORCE_DEVELOP=false
ENABLE_GPU=
# empty = autotune (INTENT; develop: GPU→1, CPU→RAM/CPU); pin for dry-run / extract / develop
CONCURRENCY=
