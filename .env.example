# run
INPUT_PATH=/mnt/photos
# scan | dry-run | extract | develop
MODE=scan
LOG_LEVEL=log
# IANA timezone for container logs (e.g. Asia/Hong_Kong, America/New_York)
TZ=Asia/Hong_Kong
INTENT=balanced

# mount
HOST_PATH=/path/to/photos
NAS_ADDR=192.0.2.10
NAS_EXPORT=/volume1/share/photos

# behaviour
DEVELOP_FALLBACK=true
# off | children (=depth:1) | depth:N — process dirs at relative depth N one-by-one (mtime newest first)
# e.g. Event/year/month layout: INPUT_PATH=/mnt/Event + depth:2 = per month
DISCOVER_SPLIT=off

# cron
CRON_ENABLE=false
CRON_START="0 2 * * *"
CRON_STOP="0 6 * * *"

# advanced
REWRITE=false
FORCE_DEVELOP=false
ENABLE_GPU=
# empty = autotune (INTENT; develop: GPU→1, CPU→RAM/CPU); pin for dry-run / extract / develop
CONCURRENCY=
