# run
INPUT_PATH=/mnt/photos
MODE=scan
LOG_LEVEL=log
INTENT=balanced

# mount
HOST_PATH=/path/to/photos
NAS_ADDR=192.0.2.10
NAS_EXPORT=/volume1/share/photos

# size
MAX_LONG_EDGE=2560
JPEG_QUALITY=85
DEVELOP_FALLBACK=true

# cron
CRON_ENABLE=false
CRON_START="0 2 * * *"
CRON_STOP="0 6 * * *"

# advanced
REWRITE=false
ENABLE_GPU=
